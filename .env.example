# Copy to .env and adjust. Empty values mean "use the default".

DEVICE=cuda

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

WYOMING_HOST=0.0.0.0
WYOMING_PORT=10200
# Advertise streaming text input to Home Assistant (sentence-by-sentence audio).
WYOMING_STREAMING=true
# mDNS discovery; only reaches your LAN with network_mode: host.
WYOMING_ZEROCONF=false

# Audio source: piper (in-process, fastest) | wyoming (any Wyoming TTS as upstream)
SOURCE=piper
WYOMING_UPSTREAM=
UPSTREAM_VOICE=
UPSTREAM_SPEAKER=

PIPER_VOICE=en_US-ljspeech-high
# Or point to your own model (takes precedence over PIPER_VOICE):
PIPER_MODEL=
PIPER_CONFIG=
# auto = GPU when DEVICE=cuda
PIPER_DEVICE=auto
PIPER_LENGTH_SCALE=
SENTENCE_SILENCE_MS=0

RVC_ENABLED=true
RVC_REPO_ID=Slichi/KasaneTeto
RVC_REVISION=
RVC_MODEL_FILE=
RVC_INDEX_FILE=
RVC_F0_METHOD=rmvpe
RVC_PITCH=0
RVC_INDEX_RATE=0.6
RVC_PROTECT=0.33

# sentence (lowest time to first audio) | whole (lowest total time)
RVC_MODE=sentence
RVC_CONCURRENCY=1

# Several voices: list them in /config/voices.yaml (see examples/voices.yaml).
# Without that file, the RVC_* variables above define a single voice.
# VOICES_FILE=/config/voices.yaml
# DEFAULT_VOICE=teto
# RVC voices kept in VRAM at once (least recently used is unloaded)
RVC_MAX_LOADED_MODELS=1


# What Home Assistant shows
WYOMING_PROGRAM_NAME=Wyoming RVC
VOICE_NAME=teto
# Defaults to the language of PIPER_VOICE (es_MX-claude-high -> es)
# VOICE_LANGUAGE=en

# Caches live under MODELS_DIR (default /models); override only if needed:
# HF_HOME=/models/huggingface

LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
